<Window x:Class="Dolap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Dolap.App.Controls"
        Title="Masaüstü Dolabı" Width="500" Height="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True"
        AutomationProperties.Name="Masaüstü Dolabı" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <Grid.LayoutTransform><ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
        <ScrollViewer x:Name="Scroller" VerticalAlignment="Bottom" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Background="{x:Null}">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource CabinetScrollBar}"/></ScrollViewer.Resources>
            <c:CabinetScene x:Name="Scene" FrontClick="Front_Click" ItemClick="Item_Click" AddClick="AddShortcut_Click"
                SearchClick="Search_Click" SettingsClick="Settings_Click" AddCategoryClick="AddCategory_Click"
                FrontContext="Front_ContextMenuOpening" ItemContext="Item_ContextMenuOpening"
                DrawerEnter="Drawer_DragEnter" DrawerLeave="Drawer_DragLeave" DrawerDrop="Drawer_Drop" HeaderDown="Header_MouseDown"/>
        </ScrollViewer>
        <ContentControl x:Name="ModalHost" VerticalAlignment="Top" Margin="20,50,20,0" Focusable="False"/>
        <Border x:Name="Toast" VerticalAlignment="Bottom" Margin="20,0,20,16" Padding="12,8" CornerRadius="6"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Visibility="{Binding ToastVisibility}" AutomationProperties.LiveSetting="Polite">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ModalButtonStyle}" Content="Geri al" Click="Undo_Click" Visibility="{Binding UndoVisibility}"/>
                <TextBlock Text="{Binding Toast}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
