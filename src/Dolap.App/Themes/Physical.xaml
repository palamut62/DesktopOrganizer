<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PhysicalMetalFront" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
                <Border Width="186" Height="34" VerticalAlignment="Top" Margin="0,17,0,0" CornerRadius="2" BorderThickness="2" BorderBrush="#FFD1D5D9">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFE3E0DA" Offset="0"/><GradientStop Color="#FFB5B5B0" Offset="0.5"/><GradientStop Color="#FFDDDBD6" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Grid Margin="8,0">
                        <Rectangle Width="3" Fill="{Binding Fill}" HorizontalAlignment="Left" Margin="0,7"/>
                        <TextBlock Text="{Binding Name}" Foreground="#FF20252B" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="12,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Count}" Foreground="#FF424952" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border x:Name="Highlight" BorderBrush="#6697CFFF" BorderThickness="2" CornerRadius="4" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Highlight" Property="Visibility" Value="Visible"/><Setter TargetName="Highlight" Property="BorderBrush" Value="#FF97CFFF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PhysicalBlockFront" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
                <Border Background="Transparent" CornerRadius="7" Margin="14,39,14,23">
                    <Grid Margin="12,0">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="{Binding LabelBrush}" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding LabelBrush}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="36,0,26,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Count}" Foreground="{Binding LabelBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border x:Name="Highlight" BorderBrush="#99FFFFFF" BorderThickness="2" CornerRadius="9" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Highlight" Property="Visibility" Value="Visible"/><Setter TargetName="Highlight" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CabinetScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#FF111820"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#FF61758C" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
