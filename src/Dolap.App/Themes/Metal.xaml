<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="OpenMs">320</sys:Double>
    <sys:Double x:Key="CloseMs">250</sys:Double>
    <CubicEase x:Key="EaseOpen" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseClose" EasingMode="EaseInOut"/>

    <DropShadowEffect x:Key="CabinetShadow" BlurRadius="22" ShadowDepth="6" Direction="300" Opacity="0.6" Color="Black"/>

    <CornerRadius x:Key="CornerTop">9,9,0,0</CornerRadius>
    <CornerRadius x:Key="CornerBottom">0,0,9,9</CornerRadius>
    <ImageBrush x:Key="BodyBrush" ImageSource="pack://application:,,,/Assets/metal_body.png" TileMode="Tile"
                Viewport="0,0,240,128" ViewportUnits="Absolute" Stretch="Fill"/>
    <SolidColorBrush x:Key="BodyEdgeBrush" Color="#FF08090B"/>
    <ImageBrush x:Key="TrayBrush" ImageSource="pack://application:,,,/Assets/tray.png" TileMode="Tile"
                Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill"/>

    <!-- Baslik sirti: perçinler -->
    <DataTemplate x:Key="HeaderDecoration">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
            <Ellipse Width="7" Height="7" Margin="0,0,6,0"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#FFE4E8EC" Offset="0"/><GradientStop Color="#FF6C737B" Offset="0.7"/><GradientStop Color="#FF20242A" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
            <Ellipse Width="7" Height="7" Margin="0,0,6,0"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#FFE4E8EC" Offset="0"/><GradientStop Color="#FF6C737B" Offset="0.7"/><GradientStop Color="#FF20242A" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
            <Ellipse Width="7" Height="7"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#FFE4E8EC" Offset="0"/><GradientStop Color="#FF6C737B" Offset="0.7"/><GradientStop Color="#FF20242A" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="DrawerFrontStyle" TargetType="Button">
        <Setter Property="Height" Value="74"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Image Source="pack://application:,,,/Assets/metal_front.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Grid Width="172" Height="27" Margin="0,11,0,0" VerticalAlignment="Top">
                            <Image Source="pack://application:,,,/Assets/metal_plate.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Rectangle Width="3" HorizontalAlignment="Left" Margin="9,6" Fill="{Binding Fill}"/>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#FF23272C"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="17,0,0,0"/>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FF1B1F24" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="34,0,30,0"/>
                            <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="#FF3A4048"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                        </Grid>
                        <Image x:Name="Handle" Source="pack://application:,,,/Assets/metal_handle.png" Width="134" Height="24" Stretch="Fill"
                               VerticalAlignment="Bottom" Margin="0,0,0,6" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border x:Name="Focus" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource ItemFocusBrush}" Visibility="Collapsed"/>
                        <Border x:Name="Hover" CornerRadius="7" Background="#18FFFFFF" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
